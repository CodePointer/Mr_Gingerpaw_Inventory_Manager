# Backend runtime configuration. Copy these values into
# backend/.env.development for local development, or configure them in the
# production hosting environment.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256

# Local development:
# DATABASE_URL=postgresql+psycopg2://admin:secret@localhost:5432/inventory
# Supabase serverless runtime: copy the Transaction pooler URL (port 6543)
# from Dashboard > Connect, change the scheme as below, and require TLS.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
DB_USE_NULL_POOL=true

ACCESS_TOKEN_EXPIRE_MINUTES=4320
RESET_TOKEN_EXPIRE_MINUTES=2880
ADMIN_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
OPENAI_API_KEY=replace-with-your-openai-api-key

# Frontend build-time configuration (normally placed in frontend/.env.development).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Migration-only value. In GitHub, store this as the SUPABASE_DB_URL secret.
# Use the Session pooler URL (port 5432), not the Transaction pooler URL.
SUPABASE_DB_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
